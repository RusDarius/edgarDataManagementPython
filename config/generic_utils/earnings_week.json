{
  "name": "earnings_week",
  "description": "Every name with a print this week (W0) and next week (W1), one row each: calendar slot, tape into the print, estimates, value to peers and to its own history, past print reactions from the day files, and the day's other suites joined by EXCHANGE:TICKER. The universe floor (markets, types, market cap) is the only filter; named ids always stay in. No composite, no course.",
  "min_market_cap_usd": 1000000000,
  "markets": ["america", "uk", "germany", "france", "switzerland", "italy", "spain", "netherlands", "sweden", "denmark",
              "norway", "finland", "belgium", "austria", "ireland", "portugal", "poland"],
  "types": ["stock", "dr"],
  "weeks": 2,
  "history_newest": 200,
  "peer": {"group_field": "ind", "min_n": 6, "fields": ["pe_nfy", "evebitda", "evrev"]},
  "slot": {"amc_from_hour_utc": 13},
  "reaction": {"min_days_between_prints": 20, "max_lag_days": 4, "max_gap_days": 5, "drift_files": 4, "runup_days": 14, "base_tolerance_days": 6},
  "revision_days": {"eps_rev_1m": 30, "eps_rev_3m": 91, "pt_drift_1m": 30},
  "revision_step_max_pct": 25.0,
  "split_guard": {"max_gap_days": 5, "jump_ratio": 1.8, "day_change_max_pct": 25.0},
  "joins": [
    {"name": "pack_tape", "duckdb": "{PACK}/briefing_pack.duckdb", "table": "us2b_tape", "id_field": "symbol",
     "fields": {"left": "left", "street_left": "street_left", "rr": "rr", "bo": "bo", "cont": "cont", "fwd": "fwd",
                "mix": "mix", "mtp": "mtp", "fp_pe_y1": "fp_pe_y1"}},
    {"name": "pack_play", "duckdb": "{PACK}/briefing_pack.duckdb", "table": "earnings_upside_curated", "id_field": "symbol",
     "fields": {"play": "pack_play"}},
    {"name": "pack_play_down", "duckdb": "{PACK}/briefing_pack.duckdb", "table": "earnings_downside_curated", "id_field": "symbol",
     "fields": {"play": "pack_play"}},
    {"name": "book", "duckdb": "{PACK}/briefing_pack.duckdb", "table": "book", "id_field": "symbol",
     "fields": {"value_usd": "book_usd", "vs_cost": "book_vs_cost"}},
    {"name": "movers", "duckdb": "{PACK}/movers/movers.duckdb", "table": "movers_tails", "id_field": "symbol",
     "concat": {"dest": "mover_tails", "format": "{horizon} {tail} #{rank}"}},
    {"name": "gmv", "duckdb": "{PACK}/gmv/gmv_lens.duckdb", "table": "lens_tape", "id_field": "symbol",
     "fields": {"lenses": "lenses", "weak_lens": "weak_lens", "tape_state": "tape_state", "rerate_floor": "rerate_floor",
                "compounder_floor": "compounder_floor", "breakout_floor": "breakout_floor",
                "value_turn_floor": "value_turn_floor", "fade_floor": "fade_floor", "exp_move_20d": "exp_move_20d",
                "updown_vol": "updown_vol"}},
    {"name": "prediction", "glob": "logs/tradingview_analysis/prediction_analysis/duckdb_runs/iso_year=*/week=*/move_prediction_*.duckdb",
     "table": "earnings_priority_consensus_rows", "id_field": "ticker", "where": "sort_flavour = 'default'", "newest_run": true,
     "fields": {"consensus_days_score": "cons_d", "consensus_weeks_score": "cons_w", "consensus_weeks_direction": "cons_w_dir",
                "consensus_weeks_confidence": "cons_w_conf", "consensus_months_score": "cons_m",
                "breakout_long_v1__weeks_score": "p_breakout_w", "early_momentum_inflection_v1__weeks_score": "p_inflect_w",
                "forward_edge_active_v2__weeks_score": "p_fwd_edge_w", "asymmetric_value__weeks_score": "p_asym_value_w",
                "value_recovery_v3__weeks_score": "p_value_rec_w", "fragility_short__weeks_score": "p_fragility_w",
                "mean_reversion_exhaustion_v1__weeks_score": "p_exhaust_w"}},
    {"name": "edge", "glob": "logs/tradingview_analysis/edge_research_tools/runs/edge_latest_*/aggregate/historical_edge_progression/edge_unified_with_history.csv",
     "id_field": "symbol",
     "fields": {"upside_prediction_score": "edge_up_score", "forward_valuation_upside_pct": "edge_fwd_up",
                "historical_validation_win_rate": "edge_hist_win", "median_fwd_5d_in_setup": "edge_med_5d",
                "big_mover_score": "edge_big_mover", "safety_bucket": "edge_safety"}},
    {"name": "peer_value", "duckdb": "{PACK}/peer_value/peer_value.duckdb", "table": "names", "id_field": "symbol",
     "fields": {"group": "peer_group", "lens": "peer_lens", "mult": "peer_mult", "ind_med": "peer_ind_med", "prem_pct": "peer_prem_pct", "just_pct": "peer_just_pct", "gap_pct": "peer_gap_pct", "px_fit": "peer_px_fit", "pctl_growth": "peer_pctl_growth", "pctl_quality": "peer_pctl_quality", "peg_vs_ind_pct": "peer_peg_vs_ind_pct", "priced_in_cagr_pct_vs_ind": "peer_pic_vs_ind"}},
    {"name": "event_risk", "duckdb": "{PACK}/event_risk/event_risk.duckdb", "table": "names", "id_field": "symbol",
     "fields": {"warn_level": "warn_level", "er_letters": "er_letters", "stress_5s_usd": "stress_5s_usd", "ev_next": "ev_next", "ev_recent_z": "ev_recent_z"}}
  ]
}
