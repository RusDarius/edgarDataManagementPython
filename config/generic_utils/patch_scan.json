{
  "name": "patch_scan",
  "description": "Knobs for generic_utils.patch_scan: where patch notes live, how changed paths group into areas, the repo guards it checks and what the capability index covers. Display knobs only: nothing here decides what a finding means.",
  "notes_dir": "documentation/patch_notes",
  "out_root": "logs/patch_notes",
  "areas": [
    ["src/generic_utils/tv_scan_cli.py", "CLI (tv_scan_cli)"],
    ["src/generic_utils/canvas_page.py", "page renderer"],
    ["src/generic_utils/", "generic_utils"],
    ["src/operator_briefing/", "operator_briefing"],
    ["src/financial_projection/", "financial_projection"],
    ["src/data_loaders/", "data_loaders"],
    ["src/data_analysis_scripts/", "data_analysis_scripts"],
    ["src/edge_research_tools/", "edge_research_tools"],
    ["src/tests/", "tests"],
    ["src/research_prompt/", "prompts"],
    ["src/run_", "runners"],
    ["src/main.py", "main.py"],
    ["src/", "src (other)"],
    ["config/generic_utils/pages/", "page templates"],
    ["config/generic_utils/canvas_ledger.json", "Ledger"],
    ["config/generic_utils/", "recipes"],
    ["config/holdings_scoring/", "Book config"],
    ["config/", "config (other)"],
    [".claude/skills/", "skills"],
    [".claude/", ".claude (settings)"],
    [".cursor/", ".cursor"],
    ["documentation/patch_notes/", "patch notes"],
    ["documentation/", "documentation"],
    ["scripts", "scripts"],
    ["CLAUDE.md", "CLAUDE.md"],
    ["README.md", "README"]
  ],
  "guards": {
    "forbidden_paths": [".vscode/settings.json", ".claude/settings.local.json"],
    "path_patterns": ["logs/", "_tmp_"],
    "text_markers": ["=== AI GENERATED CODE"],
    "text_marker_skip": ["documentation/patch_notes/", "config/generic_utils/patch_scan.json", "CLAUDE.md", ".claude/skills/",
                         "AI_CODE_DOCUMENTATION_RULES.md", "src/tests/test_patch_scan.py"],
    "sql_star_tables": ["all_fields_rows", "raw_scan_rows"]
  },
  "lint_skip": ["src/main.py"],
  "wiring": {
    "module_globs": ["src/generic_utils/*.py", "src/operator_briefing/*.py", "src/financial_projection/*.py", "src/run_*.py"],
    "recipe_dirs": ["config/generic_utils", "config/financial_projection"],
    "mentions": {
      "cli": "src/generic_utils/tv_scan_cli.py",
      "refresh": "config/generic_utils/daily_refresh.json",
      "catalog": "src/research_prompt/run_catalog.txt",
      "CLAUDE.md": "CLAUDE.md"
    },
    "skills_dir": ".claude/skills",
    "tests_dir": "src/tests"
  },
  "lifecycle": {
    "_note": "file = the hand-written record of declared status changes. signal_words are searched in added lines only (wording to read). guard_statuses: an added line that matches a pattern of an entry with one of these statuses becomes a finding, outside the entry's allow prefixes. reference_* = the working-tree files searched for what still points at a removed or deprecated thing.",
    "file": "documentation/patch_notes/lifecycle.json",
    "signal_words": ["deprecat", "retired", "legacy", "no longer", "replaced by", "superseded", "obsolete", "removed in", "do not use"],
    "signal_limit": 30,
    "signal_skip": ["documentation/patch_notes/", ".claude/skills/patch-notes/", "config/generic_utils/patch_scan.json",
                    "src/generic_utils/patch_scan.py", "src/tests/test_patch_scan.py"],
    "guard_statuses": ["deprecated", "removal_requested", "removed", "retired"],
    "reference_roots": ["src/", "config/", "scripts/", ".claude/skills/", ".cursor/rules/", "documentation/", "CLAUDE.md", "README.md"],
    "reference_skip": ["documentation/patch_notes/"],
    "reference_suffixes": [".py", ".json", ".md", ".txt", ".mdc"],
    "max_file_bytes": 2000000
  },
  "features": {
    "_note": "A feature is one module of wiring.module_globs. cli_files = the CLIs whose _cmd_<name> functions front a module; refresh_stages = the lists of the refresh graph whose steps run a feature; removed_prefixes = where a file deleted over the history is worth listing.",
    "cli_files": ["src/generic_utils/tv_scan_cli.py"],
    "refresh_stages": ["producers", "suites"],
    "page_dir": "config/generic_utils/pages",
    "removed_prefixes": ["src/", "config/", ".claude/skills/", "scripts/"],
    "removed_names_per_commit": 12
  },
  "largest_functions": 12,
  "shared_helper_min_modules": 4,
  "shared_helper_dir": "src/generic_utils",
  "capability": {
    "detail_packages": ["src/generic_utils", "src/operator_briefing", "src/financial_projection"],
    "other_packages": ["src/data_loaders", "src/data_analysis_scripts", "src/edge_research_tools", "src/db", "src/backtests", "src/backtracking",
                       "src/focus_pool_screening", "src/portfolio_performance_tracking", "src/trading_modules", "src/tools", "src/database_scripts",
                       "src/feedback_models", "scripts"],
    "runner_glob": "src/run_*.py",
    "recipe_dirs": ["config/generic_utils", "config/financial_projection"],
    "page_dir": "config/generic_utils/pages",
    "refresh": "config/generic_utils/daily_refresh.json",
    "skills_dir": ".claude/skills",
    "prompt_dir": "src/research_prompt/agent_runs",
    "catalog": "src/research_prompt/run_catalog.txt",
    "tests_dir": "src/tests",
    "doc_dirs": ["documentation", "documentation/market_insights", "documentation/improvements_plans", "documentation/data_analysis_principles"]
  }
}
